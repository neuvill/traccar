<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8"/>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: 'Noto Sans', 'Noto Sans Arabic', 'Noto Sans Tifinagh', sans-serif; font-size: 10px; color: #1A2233;
    margin: 0; padding: 0 14mm;
  }

  .vehicle.continued { page-break-before: always; }

  .masthead { background: #1E3A5C; color: #F3F6FA; padding: 14px 16px; }
  .masthead-top { width: 100%; }
  .masthead-top td { vertical-align: top; }
  .brand-name { font-size: 13px; font-weight: bold; letter-spacing: 0.06em; }
  .doc-meta { font-size: 9px; color: #C7D3E0; text-align: right; line-height: 1.5; }
  h1 { font-size: 17px; margin: 10px 0 2px; }
  .masthead-sub { font-size: 10px; color: #C7D3E0; margin: 0; }
  .vehicle-row { margin-top: 10px; padding-top: 8px; border-top: 1px solid #5B7A9C; width: 100%; }
  .vehicle-row td { padding-right: 24px; }
  .vehicle-row .label { font-size: 8px; letter-spacing: 0.08em; text-transform: uppercase; color: #9DB1C7; }
  .vehicle-row .value { font-size: 11px; font-weight: bold; }
  .logo { max-height: 28px; max-width: 120px; }

  .kpis { width: 100%; border-collapse: collapse; margin-top: 0; }
  .kpis td { border: 1px solid #DCE1E8; padding: 6px 8px; width: 25%; }
  .kpis .k-label { font-size: 8px; letter-spacing: 0.06em; text-transform: uppercase; color: #8891A0; }
  .kpis .k-value { font-size: 12px; font-weight: bold; color: #1A2233; }

  /* the masthead and KPIs live in the table header, which repeats on every page */
  .day-table { width: 100%; border-collapse: collapse; font-size: 9px; -fs-table-paginate: paginate; }
  .day-table > tbody > tr { page-break-inside: avoid; }
  .day-table > thead > tr > td.page-header { padding: 0 0 10px 0; }
  .day-table th {
    text-align: left; font-size: 8px; letter-spacing: 0.05em; text-transform: uppercase;
    color: #8891A0; padding: 4px 6px; border-bottom: 1px solid #C3CAD4;
  }
  .day-table th.num, .day-table td.num { text-align: right; }
  .day-table > tbody > tr > td { padding: 5px 6px; border-bottom: 1px solid #DCE1E8; vertical-align: top; }
  .day-table > tbody > tr.stop > td { background: #FBF3E6; }
  .day-table > tbody > tr > td.empty { padding: 12px 6px; color: #8891A0; }
  .day-table > tbody > tr > td.nowrap { white-space: nowrap; }
  .day-table > tbody > tr.closing > td { border-bottom: none; padding: 0; }
  /* each address part and separator is laid out on its own, so mixed Latin/Arabic/Tifinagh parts
     and postcodes keep their logical order instead of being reordered by the bidi algorithm */
  .addr-part { display: inline-block; }
  /* an address part and its comma stay on the same line */
  .addr-unit { display: inline-block; white-space: nowrap; }

  /* trip route: start and destination on separate lines, each with its marker */
  .route { border-collapse: collapse; margin-top: 1px; }
  .route > tbody > tr > td, .route > tr > td { padding: 1px 0; vertical-align: top; border: none; background: none; }
  .route td.mk { width: 12px; padding-top: 4px; }
  .marker { display: inline-block; width: 7px; height: 7px; vertical-align: top; }
  /* "play" triangle pointing right, drawn with borders */
  .marker.start {
    width: 0; height: 0; border-top: 4px solid transparent; border-bottom: 4px solid transparent;
    border-left: 7px solid #2E8B57;
  }
  .marker.end { background: #C0392B; }
  .badge {
    display: inline-block; font-size: 7px; font-weight: bold; letter-spacing: 0.05em; text-transform: uppercase;
    padding: 1px 4px; border-radius: 2px; color: #fff; margin-bottom: 2px;
  }
  .badge.trip { background: #2B6CA3; }
  .badge.stop { background: #9C6B16; }
  .addr { color: #1A2233; }
  .dash { color: #C3CAD4; }

  .signoff { margin-top: 24px; width: 100%; }
  .signoff td { vertical-align: bottom; padding-right: 24px; }
  .signoff-label { font-size: 8px; text-transform: uppercase; color: #8891A0; margin-bottom: 22px; }
  .signoff-rule { border-top: 1px solid #C3CAD4; width: 160px; }
  .stamp { max-height: 90px; }

  .page-footer { margin-top: 10px; font-size: 8px; color: #8891A0; width: 100%; }
  .page-footer td.right { text-align: right; }
</style>
</head>
<body>
#macro(address $parts)#foreach($part in $parts)<span class="addr-unit"><span class="addr-part">$esc.xml($part)</span>#if($foreach.hasNext)<span class="addr-part">,</span>#end</span>#if($foreach.hasNext) #end#end#end
#foreach($section in $sections)
<div class="vehicle#if($foreach.count > 1) continued#end">
  <table class="day-table">
    <thead>
    <tr><td class="page-header" colspan="7">
      <div class="masthead">
        <table class="masthead-top"><tr>
          <td>
            #if($logoDataUri)<img class="logo" src="$esc.xml($logoDataUri)"/>#else<span class="brand-name">$esc.xml($brandName)</span>#end
          </td>
          <td class="doc-meta">
            $esc.xml($translations.get("generated")) $esc.xml($generatedAt)<br/>
            $esc.xml($translations.get("vehicle")) $section.vehicleIndex / $section.vehicleCount
          </td>
        </tr></table>
        <h1>$esc.xml($translations.get("title"))</h1>
        <table class="vehicle-row"><tr>
          <td>
            <div class="label">$esc.xml($translations.get("vehicle"))</div>
            <div class="value">$esc.xml($section.deviceName)</div>
          </td>
          <td>
            <div class="label">$esc.xml($translations.get("group"))</div>
            <div class="value">$esc.xml($section.groupName)</div>
          </td>
        </tr></table>
      </div>

      <table class="kpis">
        <tr>
          <td>
            <div class="k-label">$esc.xml($translations.get("kpiDistance"))</div>
            <div class="k-value">$esc.xml($section.distance)</div>
          </td>
          <td>
            <div class="k-label">$esc.xml($translations.get("kpiDriving"))</div>
            <div class="k-value">$esc.xml($section.drivingTime)</div>
          </td>
          <td>
            <div class="k-label">$esc.xml($translations.get("kpiStopped"))</div>
            <div class="k-value">$esc.xml($section.stoppedTime)</div>
          </td>
          <td>
            <div class="k-label">$esc.xml($translations.get("kpiAvgSpeed"))</div>
            <div class="k-value">$esc.xml($section.averageSpeed)</div>
          </td>
        </tr>
        <tr>
          <td>
            <div class="k-label">$esc.xml($translations.get("kpiTrips"))</div>
            <div class="k-value">$section.tripCount</div>
          </td>
          <td>
            <div class="k-label">$esc.xml($translations.get("kpiStops"))</div>
            <div class="k-value">$section.stopCount</div>
          </td>
          <td>
            <div class="k-label">$esc.xml($translations.get("kpiOdoStart"))</div>
            <div class="k-value">$esc.xml($section.odometerStart)</div>
          </td>
          <td>
            <div class="k-label">$esc.xml($translations.get("kpiOdoEnd"))</div>
            <div class="k-value">$esc.xml($section.odometerEnd)</div>
          </td>
        </tr>
      </table>
    </td></tr>
    <tr>
      <th>$esc.xml($translations.get("colTime"))</th>
      <th>$esc.xml($translations.get("colDuration"))</th>
      <th>$esc.xml($translations.get("colRoute"))</th>
      <th class="num">$esc.xml($translations.get("colDistance"))</th>
      <th class="num">$esc.xml($translations.get("colSpeed"))</th>
      <th class="num">$esc.xml($translations.get("colOdometer"))</th>
      <th class="num">$esc.xml($translations.get("colFuel"))</th>
    </tr>
    </thead>
    <tbody>
    #if($section.rows.isEmpty())
      <tr><td class="empty" colspan="7">$esc.xml($translations.get("noEntries"))</td></tr>
    #end
    #foreach($row in $section.rows)
      <tr class="#if($row.trip)trip#{else}stop#end">
        <td class="nowrap">$esc.xml($row.timeRange)</td>
        <td class="nowrap">$esc.xml($row.duration)</td>
        <td>
          #if($row.trip)
          <div class="badge trip">$esc.xml($translations.get("badgeTrip"))</div>
          <table class="route">
            <tr><td class="mk"><span class="marker start"></span></td><td class="addr">#address($row.fromAddressParts)</td></tr>
            <tr><td class="mk"><span class="marker end">&#160;</span></td><td class="addr">#address($row.toAddressParts)</td></tr>
          </table>
          #else
          <div class="badge stop">$esc.xml($translations.get("badgeStop"))</div>
          <div class="addr">#address($row.fromAddressParts)</div>
          #end
        </td>
        <td class="num">$esc.xml($row.distance)</td>
        <td class="num">$esc.xml($row.speed)</td>
        <td class="num">$esc.xml($row.odometer)</td>
        <td class="num">$esc.xml($row.fuel)</td>
      </tr>
    #end
    ## sign-off and footer are the last table row, so they stay together and get the repeated header
    <tr class="closing"><td colspan="7">
      #if(!$foreach.hasNext)
      <table class="signoff"><tr>
        <td>
          <div class="signoff-label">$esc.xml($translations.get("preparedBy"))</div>
          <div class="signoff-rule">&#160;</div>
        </td>
        <td>
          <div class="signoff-label">$esc.xml($translations.get("signature"))</div>
          <div class="signoff-rule">&#160;</div>
        </td>
        <td style="text-align:right">
          #if($stampDataUri)<img class="stamp" src="$esc.xml($stampDataUri)"/>#end
        </td>
      </tr></table>
      #end
      <table class="page-footer"><tr>
        <td>$esc.xml($translations.get("footerConfidential"))</td>
        <td class="right">$esc.xml($translations.get("footerSource"))</td>
      </tr></table>
    </td></tr>
    </tbody>
  </table>
</div>
#end
</body>
</html>
